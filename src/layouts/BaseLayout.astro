---
import '../styles/global.css';
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/junior-nisa/" aria-label="こどもNISA設計室 ホーム">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-copy"><b>こどもNISA設計室</b><small>子どもの未来を、いちばん近くで考える。</small></span>
      </a>
      <nav class="desktop-nav" aria-label="メインナビゲーション">
        <a href="/junior-nisa/system/">制度</a>
        <a href="/junior-nisa/gift-tax/">贈与税</a>
        <a href="/junior-nisa/withdrawal/">引き出し</a>
        <a href="/junior-nisa/calculator/">試算</a>
        <a href="/junior-nisa/providers/">金融機関</a>
        <a href="/junior-nisa/updates/">更新情報</a>
        <a href="/junior-nisa/sources/">一次資料</a>
      </nav>
      <a class="header-cta" href="/junior-nisa/#quick">まず30秒で理解 →</a>
      <details class="mobile-menu">
        <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
        <nav>
          <a href="/junior-nisa/system/">制度</a>
          <a href="/junior-nisa/gift-tax/">贈与税</a>
          <a href="/junior-nisa/withdrawal/">引き出し</a>
          <a href="/junior-nisa/calculator/">試算</a>
          <a href="/junior-nisa/providers/">金融機関</a>
          <a href="/junior-nisa/updates/">更新情報</a>
          <a href="/junior-nisa/sources/">一次資料</a>
        </nav>
      </details>
    </div>
  </header>

  <main><slot /></main>

  <nav class="bottom-nav" aria-label="スマートフォン用ナビゲーション">
    <a href="/junior-nisa/"><span aria-hidden="true">⌂</span><small>ホーム</small></a>
    <a href="/junior-nisa/system/"><span aria-hidden="true">▤</span><small>制度</small></a>
    <a href="/junior-nisa/calculator/"><span aria-hidden="true">▥</span><small>試算</small></a>
    <a href="/junior-nisa/providers/"><span aria-hidden="true">▦</span><small>比較</small></a>
    <a href="/junior-nisa/sources/"><span aria-hidden="true">≡</span><small>資料</small></a>
  </nav>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div><strong>こどもNISA設計室</strong><p>制度を知る。家族のお金を設計する。</p></div>
      <p>本サイトは一般的な情報提供を目的とし、投資・税務の個別助言ではありません。重要な判断では公的機関・金融機関の最新情報をご確認ください。</p>
    </div>
  </footer>

  <script is:inline>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      }, { threshold: 0.12 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</body>
</html>
