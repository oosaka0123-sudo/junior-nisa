---
import '../styles/global.css';
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="theme-color" content="#0b4f9c"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
</head><body>
<header class="site-header"><a class="brand" href="/junior-nisa/"><span class="brand-mark" aria-hidden="true">◒</span><span>こどもNISA設計室<small>制度を知る。家族のお金を設計する。</small></span></a>
<nav class="desktop-nav" aria-label="メイン"><a href="/junior-nisa/system/">制度</a><a href="/junior-nisa/gift-tax/">贈与税</a><a href="/junior-nisa/withdrawal/">引き出し</a><a href="/junior-nisa/calculator/">試算</a><a href="/junior-nisa/providers/">金融機関</a><a href="/junior-nisa/updates/">更新情報</a><a href="/junior-nisa/sources/">一次資料</a></nav>
<details class="mobile-menu"><summary aria-label="メニューを開く">☰</summary><div><a href="/junior-nisa/system/">制度</a><a href="/junior-nisa/gift-tax/">贈与税</a><a href="/junior-nisa/withdrawal/">引き出し</a><a href="/junior-nisa/calculator/">試算</a><a href="/junior-nisa/providers/">金融機関</a><a href="/junior-nisa/updates/">更新情報</a><a href="/junior-nisa/sources/">一次資料</a></div></details></header>
<main><slot /></main>
<nav class="bottom-nav" aria-label="スマートフォン用ナビ"><a href="/junior-nisa/">⌂<span>ホーム</span></a><a href="/junior-nisa/system/">▤<span>制度</span></a><a href="/junior-nisa/calculator/">▥<span>試算</span></a><a href="/junior-nisa/providers/">▦<span>比較</span></a><a href="/junior-nisa/sources/">☰<span>資料</span></a></nav>
<footer><div class="footer-brand"><strong>こどもNISA設計室</strong><span>制度を知る。家族のお金を設計する。</span></div><p>本サイトは一般的な情報提供を目的とし、投資・税務の個別助言ではありません。重要な判断は公的機関・金融機関の最新情報をご確認ください。</p><p class="photo-credit">ヒーロー写真: Arina Krasnikova / Pexels</p></footer>
<script is:inline>
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!reduce){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('is-visible')}),{threshold:.12});document.querySelectorAll('[data-reveal]').forEach(el=>io.observe(el));}
</script></body></html>